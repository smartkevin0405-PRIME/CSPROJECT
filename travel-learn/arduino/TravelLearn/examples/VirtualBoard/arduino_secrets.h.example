// 이 파일은 생성형 AI(Claude)의 도움을 받아 작성했습니다.
// ------------------------------------------------------------------
// 사용법
//  1) 이 파일을 같은 폴더에 arduino_secrets.h 라는 이름으로 복사한다.
//  2) 아래 자리표시자를 실제 값으로 바꾼다.
//  3) arduino_secrets.h 는 절대 git에 올리지 않는다(Wi-Fi 비밀번호와 키가 들어 있다).
//
// 공유 키(SECRET_KEY_USER1/2)는 16진수 32글자이며,
// 폰 앱의 설정 화면에도 "똑같은 값"을 입력해야 통신이 된다.
// 무작위 키 만드는 법(PC에서):
//   python -c "import secrets; print(secrets.token_hex(16))"
// ------------------------------------------------------------------

#define SECRET_SSID "집_공유기_이름"          // 2.4 GHz Wi-Fi
#define SECRET_PASS "와이파이_비밀번호"

#define SECRET_KEY_USER1 "00000000000000000000000000000000"   // 1번 사용자 키(32자리 16진수)
// 2번 사용자도 시험하려면 아래 줄의 주석을 풀고 키를 넣는다.
// #define SECRET_KEY_USER2 "00000000000000000000000000000000"
